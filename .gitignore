# ============================================================
# Radar FIDC — .gitignore
# ============================================================

# Credenciais e variáveis de ambiente (NUNCA commitar)
.env
*.env
.env.local

# Arquivos internos do projeto (orquestrador interno)
AGENT.md
MEMORY.md
POWERBI_SETUP.md
ralph.sh
prd.json
ralph.log

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Dados locais bronze/silver/gold gerados pelo pipeline Azure
data/
*.parquet

# CSVs em geral são gitignored, EXCETO os datasets fixos do projeto
*.csv
!data_real/**/*.csv
!data_real/*.csv

# Datasets binários do projeto (versionados — são fontes do dashboard)
!data_real/*.xlsx
!data_real/*.pkl

# macOS
.DS_Store
.AppleDouble
._*

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Logs
*.log
logs/
