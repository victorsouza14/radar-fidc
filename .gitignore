data/
*.parquet
*.csv

# macOS
.DS_Store
.AppleDouble
._*

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Logs
*.log
logs/
