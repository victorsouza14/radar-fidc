# ============================================================
# Radar FIDC — .gitignore
# ============================================================

# Credenciais e variáveis de ambiente (NUNCA commitar)
.env
*.env
.env.local

# Arquivos internos do projeto (orquestrador interno)
AGENT.md
MEMORY.md
POWERBI_SETUP.md
ralph.sh
prd.json
ralph.log

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Dados locais bronze/silver/gold gerados pelo pipeline Azure (fora do repo)
data/

# Por padrão CSVs e Parquets ficam fora — exceto os datasets fixos do projeto
*.csv
*.parquet
!data_real/**/*.csv
!data_real/*.csv
!data_real/**/*.parquet

# Datasets binários do projeto (versionados — fontes do dashboard)
!data_real/*.xlsx
!data_real/*.pkl

# macOS
.DS_Store
.AppleDouble
._*

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Logs
*.log
logs/
