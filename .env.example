# ============================================================
# Radar FIDC — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha com seus valores:
#   cp .env.example .env
#
# NUNCA commite o arquivo .env no Git.
# ============================================================

# ------------------------------------------------------------
# Azure Data Lake Storage Gen2
# ------------------------------------------------------------
# Connection string completa da conta de armazenamento Azure
AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=SEU_ACCOUNT_NAME;AccountKey=SUA_ACCOUNT_KEY;EndpointSuffix=core.windows.net

# Nome da conta de armazenamento (ex: stdatatalake2026)
AZURE_STORAGE_ACCOUNT_NAME=SEU_ACCOUNT_NAME

# Chave de acesso primária da conta Azure Storage
AZURE_STORAGE_ACCOUNT_KEY=SUA_ACCOUNT_KEY

# ------------------------------------------------------------
# Azure Databricks
# ------------------------------------------------------------
# URL do workspace Databricks (sem barra no final)
DATABRICKS_HOST=https://adb-XXXXXXXXXXXXXXXXX.X.azuredatabricks.net

# Token de acesso pessoal (PAT) gerado no Databricks
# User Settings → Developer → Access Tokens → Generate New Token
DATABRICKS_TOKEN=dapi_SEU_TOKEN_AQUI

# ID do cluster a ser utilizado para execução dos notebooks
DATABRICKS_CLUSTER_ID=XXXX-XXXXXX-XXXXXXXX

# ------------------------------------------------------------
# Configurações da Pipeline (opcionais)
# ------------------------------------------------------------
# Container principal no ADLS Gen2
AZURE_CONTAINER_BRONZE=bronze
AZURE_CONTAINER_SILVER=silver
AZURE_CONTAINER_GOLD=gold

# Caminho base dos notebooks no Databricks
DATABRICKS_NOTEBOOK_PATH=/Users/SEU_EMAIL@dominio.com/03_gold_modelagem
